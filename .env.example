QWEN_IMAGE_21_PATH=~/models/Qwen-Image-2.1
QWEN_IMAGE_21_TURBO_PATH=~/models/Qwen-Image-2.1-Turbo
# QWEN_IMAGE_21_DEVICE=auto
# bf16, int8 or fp8 (int8: quantized while loading, transformer ~50% and text encoder ~57% of the memory, ~15% slower;
# fp8: the same memory as int8). The transformer also takes fp8_dynamic: activations too, CUDA with FP8 support only
# TRANSFORMER_PRECISION=bf16
# TEXT_ENCODER_PRECISION=bf16
# CUDA beside another GPU process: the share of the card this server may hold, a render over it fails alone
# GPU_MEMORY_FRACTION=0.50
# Total reference pixels per request; past it every reference shrinks evenly. 7340032 keeps 7 at full size
# MAX_REFERENCE_PIXELS=10485760
# HOST=127.0.0.1
# PORT=8740
# PRELOAD=turbo
# MAX_QUEUED=64
# TASK_TTL=3600
# DB_PATH=data/imagegen.sqlite3

# Required: clients send it as `Authorization: Bearer <key>`. Make one with: openssl rand -hex 32
IMAGEGEN_API_KEY=
# At least one of these three is required. A model with no path is off; a path that is set must exist
QWEN_IMAGE_21_PATH=~/models/Qwen-Image-2.1
QWEN_IMAGE_21_TURBO_PATH=~/models/Qwen-Image-2.1-Turbo
# KLEIN_PATH=~/models/flux-3-image-klein
# The prompt upsampler, for Klein requests that send "upsample": true. Clients otherwise send full scene captions
# KLEIN_UPSAMPLER_PATH=~/models/flux-3-image-klein-pup
# IMAGEGEN_DEVICE=auto
# Every model. bf16, int8 or fp8 (int8: quantized while loading, transformer ~50% and text encoder ~57% of the memory,
# ~15% slower, measured with Turbo; fp8: the same memory as int8). The transformer also takes fp8_dynamic: activations
# too, CUDA with FP8 support only
# TRANSFORMER_PRECISION=bf16
# TEXT_ENCODER_PRECISION=bf16
# CUDA beside another GPU process: the share of the card this server may hold, a render over it fails alone
# GPU_MEMORY_FRACTION=0.50
# Every model: total reference pixels per request; past it every reference shrinks evenly. 7340032 keeps 7 at full size.
# For Klein it only matters with several references, and only when the budget is tighter than 1 MP each
# MAX_REFERENCE_PIXELS=10485760
# HOST=127.0.0.1
# PORT=8740
# Models of one family only: turbo, base,turbo or klein
# PRELOAD=turbo
# MAX_QUEUED=64
# TASK_TTL=3600
# DB_PATH=data/imagegen.sqlite3

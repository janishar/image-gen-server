# Required: clients send it as `Authorization: Bearer <key>`. Make one with: openssl rand -hex 32
IMAGEGEN_API_KEY=
# At least one of these three is required. A model with no path is off; a path that is set must exist
QWEN_IMAGE_21_PATH=~/models/Qwen-Image-2.1
QWEN_IMAGE_21_TURBO_PATH=~/models/Qwen-Image-2.1-Turbo
# FLUX_KLEIN_PATH=~/models/flux-3-image-klein
# The prompt upsampler, for Klein requests that send "upsample": true. Clients otherwise send full scene captions
# FLUX_KLEIN_UPSAMPLER_PATH=~/models/flux-3-image-klein-pup
# IMAGEGEN_DEVICE=auto
# The default for every family. bf16, int8 or fp8 (int8: quantized while loading, transformer ~50% and text encoder ~57%
# of the memory, ~15% slower, measured with Turbo; fp8: the same memory as int8). The transformer also takes fp8_dynamic:
# activations too, CUDA with FP8 support only
# TRANSFORMER_PRECISION=bf16
# TEXT_ENCODER_PRECISION=bf16
# The default for every family: total reference pixels per request; past it every reference shrinks evenly. 7340032
# keeps 7 at full size. For Klein it only matters with several references, and only when the budget is tighter than
# 1 MP each
# MAX_REFERENCE_PIXELS=10485760
# One family only: prefix any of the three keys above with QWEN_ or FLUX_, and it wins over the shared key for that
# family. Per family and not per model because qwen-base and qwen-turbo share one text encoder. The values are the same
# as the shared key's, so fp8_dynamic stays transformer only: {FAMILY}_TEXT_ENCODER_PRECISION refuses it too.
# Qwen's text encoder in int8, Klein's in bf16:
# QWEN_TEXT_ENCODER_PRECISION=int8
# FLUX_TEXT_ENCODER_PRECISION=bf16
# QWEN_TRANSFORMER_PRECISION=bf16
# FLUX_TRANSFORMER_PRECISION=bf16
# QWEN_MAX_REFERENCE_PIXELS=10485760
# FLUX_MAX_REFERENCE_PIXELS=10485760
# CUDA beside another GPU process: the share of the card this server may hold, a render over it fails alone. Shared by
# every family, like IMAGEGEN_DEVICE: neither has a per-family key
# GPU_MEMORY_FRACTION=0.50
# HOST=127.0.0.1
# PORT=8740
# Models of one family only: qwen-turbo, qwen-base,qwen-turbo or flux-klein
# PRELOAD=qwen-turbo
# MAX_QUEUED=64
# TASK_TTL=3600
# DB_PATH=data/imagegen.sqlite3
